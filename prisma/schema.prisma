// Next-Gen Cyber Math — data model
//
// 本番(Render)は PostgreSQL。ローカル動作確認用に SQLite へ一時切替している。
// SQLite は enum を未サポートのため、difficulty / type は String で保持する
// （値は "A".."D_PLUS" / "INSIGHT".."SOLUTION"。src/lib/types.ts の型と一致）。
// 本番へ戻すときは provider を "postgresql" に戻し、必要なら enum を再導入する。
//
// アプリ自体は src/data の静的データから動くため、DB が無くても動作する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url は prisma.config.ts の @prisma/adapter-pg で供給されるため省略。
  // Prisma 7 driver-adapter 構成では schema への url 記述は不要。
}

model Problem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  unit        String // 単元 (例: "三角関数", "図形と方程式")
  /// 難易度。"A" | "B" | "C" | "D" | "D_PLUS"
  difficulty  String
  /// 問題文。KaTeX 記法を含む Markdown 互換テキスト。
  statement   String
  /// 問題の「美しさ」を一言で示すフック。一覧カードに表示。
  tagline     String?
  hasGraph    Boolean  @default(false)
  /// JSXGraph の初期化パラメータ ({ graphKey } など)。
  graphConfig Json?
  /// 関連する授業 (Lesson) の slug。解説末尾の誘導 CTA に使う。
  relatedLessonSlug String?
  /// 概念タグ（知識のネットワーク化）。
  tags        String[] @default([])
  // ---- 過去問道場メタ (任意) ----
  /// 出題大学（オリジナル類題は「○○大（類題）」表記）。
  university  String?
  /// 偏差値帯 (50 | 55 | 60 | 65 | 70)。
  deviation   Int?
  /// 出題年度。
  year        Int?
  /// 問題の背景にある定石テーマ。
  backgroundTag String?
  steps       ExplanationStep[]
  dailyOn     DailyChallenge[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([unit])
  @@index([difficulty])
}

model ExplanationStep {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// ステップ種別。"INSIGHT" | "EXPERIMENT" | "HINT" | "SOLUTION" | "GUIDANCE_ANALYSIS"
  type      String
  /// 同一問題内での開示順 (0 始まり)。
  order     Int
  /// 見出し。
  title     String
  /// 本文。KaTeX を含む Markdown 互換テキスト。
  body      String
  /// このステップから関連授業へ (任意)。
  relatedLessonSlug String?

  @@unique([problemId, order])
}

/// Concept Lesson —「めっちゃわかりやすい授業」。
/// content は KaTeX 対応 Markdown。JSXGraph ラボは @@lab:<graphKey>@@ で埋め込む。
model Lesson {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  unit      String
  summary   String?
  /// 本文 (Markdown + KaTeX + @@lab 埋め込み)。
  content   String
  /// 授業 → 関連問題への逆リンク (slug 配列)。
  relatedProblemSlugs String[]
  /// 概念タグ。
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unit])
}

/// ユーザーアカウント。
/// role は "MENTOR" | "STUDENT"。passcode は bcryptjs ハッシュ済み。
model User {
  id          String   @id @default(cuid())
  name        String   @unique
  passcode    String
  role        String   @default("STUDENT")
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attempts         ExamAttempt[]
  englishAttempts  EnglishAttempt[]
  missions         EmergencyMission[]
  messages         Message[]          @relation("ReceivedMessages")
  sentMessages     Message[]          @relation("SentMessages")
  reviewItems      ReviewItem[]

  @@index([name])
  @@index([role])
}

/// 採点可能な公開模試の受験結果（匿名セッションまたはログインユーザーごと）。
/// 得点・満点・弱点タグはサーバーが公開済み正答データから再計算して保存する。
model ExamAttempt {
  id           String   @id @default(cuid())
  /// 匿名セッション (localStorage の UUID)。
  sessionId    String
  createdAt    DateTime @default(now())
  // --- 生成条件 ---
  tags         String[] @default([])
  difficulties String[] @default([])
  problemSlugs String[]
  timeLimitSec Int
  // --- 結果 ---
  wrongSlugs   String[] @default([])
  score        Int
  totalCount   Int
  durationSec  Int
  weakTags     String[] @default([])
  // --- ユーザー紐付け（オプショナル）---
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([createdAt])
  @@index([userId])
}

/// 師範が特定の生徒に発令する「緊急ミッション」。
/// problemSlug は静的データの slug を参照（DB Problem との FK は不要）。
model EmergencyMission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 出題する問題の slug（静的データから参照）。
  problemSlug String
  /// 師範からの熱いメッセージ。
  comment     String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isCompleted])
  @@index([createdAt])
}

/// 師範から生徒（または全員）へのメッセージ。
/// receiverId が null のときは全員への一斉送信。
/// senderId は送信者 User の id。MENTOR 専用 API で作成されるが、
/// 複数師範対応・監査のためフィールドとして保持する。
model Message {
  id         String   @id @default(cuid())
  senderId   String?
  sender     User?    @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  receiverId String?
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

/// 英語学習の受験結果（速読・精読・マルチソース）。
/// ログイン済み生徒が問題を解いたとき、クライアントから POST される。
model EnglishAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  /// "speed-reading" | "comprehension" | "multi-source"
  mode      String
  /// "TEXTBOOK" | "COMMON_TEST" | "PRIVATE_UNI" | "NATIONAL_UNI"
  level     String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([mode])
  @@index([createdAt])
}

/// 間隔反復復習キュー。数学・英語・共通テストドリル問題を横断管理する。
model ReviewItem {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "common-test-drill" | "math-problem" | "english-problem"
  itemType        String
  /// 問題ID。math-problem の場合は problemSlug、common-test-drill は questionId。
  itemId          String
  /// 科目ID。"math-1a" | "math-2bc" | "english-reading" | "math" | "english"
  subjectId       String?
  /// 共通テスト大問ID（"section-1" など）
  sectionId       String?
  /// 表示用タイトル
  title           String?
  /// "common-test-drill" | "mock" | "drill" | "manual"
  source          String

  /// "ACTIVE" | "MASTERED"
  status          String    @default("ACTIVE")
  /// SRS レベル。正解で +1、不正解で 0 にリセット。4 以上で MASTERED。
  level           Int       @default(0)
  wrongCount      Int       @default(1)
  correctStreak   Int       @default(0)

  /// "wrong" | "guessed-correct" | "dangerous-misconception" | "overtime"
  reasonFlags     String[]
  skillTags       String[]

  nextReviewAt    DateTime
  lastReviewedAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, itemType, itemId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@index([userId, subjectId])
  @@index([userId, sectionId])
}

model DailyChallenge {
  id        String   @id @default(cuid())
  /// 出題日 (00:00 UTC 正規化)。
  date      DateTime
  /// 「今日の3題」の枠 (1..3)。
  slot      Int
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])

  @@unique([date, slot])
  @@index([date])
}
